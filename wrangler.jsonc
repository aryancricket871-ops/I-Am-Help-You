{
  "name": "i-am-help-you",
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "i-am-help-you-db",
      "database_id": "4c26fadd-ea36-4131-9b1d-6f8dbbf2e237"
    }
  ]
}
